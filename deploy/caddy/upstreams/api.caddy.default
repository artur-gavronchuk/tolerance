# Committed starting point for /etc/caddy/upstreams/api.caddy: 100% stable,
# no canary. deploy.sh copies this to api.caddy the first time it's missing;
# deploy/release.sh's canary-start/promote/abort rewrite api.caddy directly
# afterwards (never this file). See the Caddyfile for how it's imported.
dynamic a api 8080 {
	refresh 5s
}
lb_policy least_conn
