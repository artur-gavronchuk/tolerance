# Production Caddy for tolerance.cc. This file is the source of truth:
# deploy.yml ships it to /opt/tolerance/Caddyfile and reloads Caddy, so edits
# made by hand on the server are overwritten on the next deploy.
{
	# Cloudflare's edge ranges (https://www.cloudflare.com/ips-v4, ips-v6) as
	# of 2026-09-25: CF-Connecting-IP is trusted only from them.
	servers {
		trusted_proxies static \
 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 \
 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 \
 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 \
 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 \
 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 \
 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For

		timeouts {
			read_header 10s
			read_body 30s
			write 60s
			idle 2m
		}
		max_header_size 64KB
	}
}

# Authenticated Origin Pulls: only Cloudflare's proxy for our zone can
# complete a TLS handshake (zone setting tls_client_auth=on). CA:
# origin-pull.cloudflare.net, valid until 2029-11-01. Direct HTTPS to the
# origin fails by design; ACME HTTP-01 on :80 is unaffected.
(cloudflare_origin_pull) {
	tls {
		client_auth {
			mode require_and_verify
			trust_pool inline {
				trust_der 
			}
		}
	}
}

{$ARENA_DOMAIN} {
	import cloudflare_origin_pull

	encode zstd gzip

	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>Cookie delete
				request>headers>Authorization delete
				resp_headers>Set-Cookie delete
			}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
		-Server
	}

	handle /api/v1/healthz {
		rewrite * /healthz
		reverse_proxy api:8080
	}

	handle /api/* {
		# The backend enforces per-route caps (5 MiB submission zips, 2 MiB
		# bot archives); this only keeps Caddy from being the stricter one.
		request_body {
			max_size 8MB
		}
		reverse_proxy api:8080 {
			header_up X-Real-IP {client_ip}
		}
	}

	handle {
		reverse_proxy web:3000
	}
}

www.{$ARENA_DOMAIN} {
	import cloudflare_origin_pull
	redir https://{$ARENA_DOMAIN}{uri} permanent
}

# mentor.nualimov.dev (repo artur-gavronchuk/nualimov.dev): its own stack runs
# from /root/nualimov.dev with no public ports; its Caddy joins
# tolerance_default as mentor-web.
mentor.nualimov.dev {
	import cloudflare_origin_pull
	reverse_proxy mentor-web:80 {
		header_up X-Forwarded-For {client_ip}
	}
}
