 {
  "name": "Shift+Right moves a card to the next column, appended at the end",
  "steps": [
   {
    "op": "goto",
    "path": "/"
   },
   {
    "op": "fill",
    "selector": "[data-testid=new-card-input]",
    "value": "Alpha"
   },
   {
    "op": "click",
    "selector": "[data-testid=add-card]"
   },
   {
    "op": "fill",
    "selector": "[data-testid=new-card-input]",
