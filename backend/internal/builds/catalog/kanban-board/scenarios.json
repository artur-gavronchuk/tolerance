    "key": "Shift+ArrowRight"
   },
   {
    "op": "expect_js",
    "expr": "[...document.querySelectorAll('[data-testid=column-todo] [data-testid=card-title]')].map(e => e.textContent)",
    "value": [
     "Bravo"
    ]
   },
   {
    "op": "expect_js",
    "expr": "[...document.querySelectorAll('[data-testid=column-doing] [data-testid=card-title]')].map(e => e.textContent)",
    "value": [
     "Charlie",
     "Alpha"
    ]
   },
   {
    "op": "expect_text",
    "selector": "[data-testid=count-todo]",
    "text": "1"
   },
   {
    "op": "expect_text",
    "selector": "[data-testid=count-doing]",
    "text": "2"
   },
   {
    "op": "press",
    "selector": "[data-testid=card]:has-text(\"Charlie\")",
    "key": "Shift+ArrowRight"
   },
   {
    "op": "expect_js",
    "expr": "[...document.querySelectorAll('[data-testid=column-doing] [data-testid=card-title]')].map(e => e.textContent)",
    "value": [
     "Alpha"
    ]
   },
   {
    "op": "expect_js",
    "expr": "[...document.querySelectorAll('[data-testid=column-done] [data-testid=card-title]')].map(e => e.textContent)",
    "value": [
     "Charlie"
    ]
   }
  ]
