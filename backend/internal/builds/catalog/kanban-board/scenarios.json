 {
  "name": "titles are shown as text, never as HTML",
  "steps": [
   {
    "op": "goto",
    "path": "/"
   },
   {
    "op": "fill",
    "selector": "[data-testid=new-card-input]",
    "value": "<b>bold</b> & <img src=x onerror=window.__pwned=1>"
   },
   {
    "op": "click",
    "selector": "[data-testid=add-card]"
   },
   {
    "op": "expect_js",
    "expr": "[...document.querySelectorAll('[data-testid=column-todo] [data-testid=card-title]')].map(e => e.textContent)",
    "value": [
     "<b>bold</b> & <img src=x onerror=window.__pwned=1>"
    ]
   },
   {
    "op": "expect_js",
    "expr": "window.__pwned === undefined && document.querySelectorAll('[data-testid=card] b, [data-testid=card] img').length === 0",
    "value": true
   }
  ]
 },
 {
