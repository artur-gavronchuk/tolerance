[
 {
  "name": "the three columns exist",
  "steps": [
   {
    "op": "goto",
    "path": "/"
   },
   {
    "op": "expect_visible",
    "selector": "[data-testid=column-todo]"
   },
   {
    "op": "expect_visible",
    "selector": "[data-testid=column-doing]"
   },
   {
    "op": "expect_visible",
    "selector": "[data-testid=column-done]"
   },
   {
    "op": "expect_visible",
    "selector": "[data-testid=new-card-input]"
   },
   {
    "op": "expect_text",
    "selector": "[data-testid=count-todo]",
    "text": "0"
   },
   {
    "op": "expect_text",
    "selector": "[data-testid=count-doing]",
    "text": "0"
   },
   {
    "op": "expect_text",
    "selector": "[data-testid=count-done]",
    "text": "0"
   }
  ]
 },
 {
  "name": "added cards land in To do, in order, with counts",
  "steps": [
   {
    "op": "goto",
    "path": "/"
   },
   {
    "op": "fill",
    "selector": "[data-testid=new-card-input]",
    "value": "Alpha"
   },
   {
    "op": "click",
    "selector": "[data-testid=add-card]"
   },
   {
    "op": "fill",
    "selector": "[data-testid=new-card-input]",
    "value": "Bravo"
   },
   {
    "op": "click",
    "selector": "[data-testid=add-card]"
   },
   {
    "op": "fill",
    "selector": "[data-testid=new-card-input]",
    "value": "Charlie"
   },
   {
    "op": "click",
    "selector": "[data-testid=add-card]"
   },
   {
    "op": "expect_js",
    "expr": "[...document.querySelectorAll('[data-testid=column-todo] [data-testid=card-title]')].map(e => e.textContent)",
    "value": [
     "Alpha",
     "Bravo",
     "Charlie"
    ]
   },
   {
    "op": "expect_js",
    "expr": "[...document.querySelectorAll('[data-testid=column-doing] [data-testid=card-title]')].map(e => e.textContent)",
    "value": []
   },
   {
    "op": "expect_text",
    "selector": "[data-testid=count-todo]",
    "text": "3"
   },
   {
    "op": "expect_text",
    "selector": "[data-testid=count-doing]",
    "text": "0"
   }
  ]
 },
 {
  "name": "the input is cleared after adding",
  "steps": [
   {
    "op": "goto",
    "path": "/"
   },
   {
    "op": "fill",
