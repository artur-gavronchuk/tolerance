[
 {
  "name": "a new game starts with the documented snake, direction and score",
  "steps": [
   {
    "op": "goto",
    "path": "/?test=1"
   },
   {
    "op": "js",
    "expr": "window.snake.reset(1)"
   },
   {
    "op": "expect_js",
    "expr": "window.snake.state().snake",
    "value": [
     [
      10,
      10
     ],
     [
      9,
      10
     ],
     [
      8,
      10
     ]
    ]
   },
   {
    "op": "expect_js",
    "expr": "window.snake.state().dir",
    "value": "right"
   },
   {
    "op": "expect_js",
    "expr": "window.snake.state().score",
    "value": 0
   },
   {
    "op": "expect_js",
    "expr": "window.snake.state().over",
    "value": false
   }
  ]
 },
 {
  "name": "the first food is drawn from the seed",
