 {
  "name": "leaving the field ends the game (no wrap-around), and ticks after it do nothing",
  "steps": [
   {
    "op": "goto",
    "path": "/?test=1"
   },
   {
    "op": "js",
    "expr": "window.snake.reset(5, {\"food\": [0, 0]})"
   },
   {
    "op": "js",
    "expr": "(() => { for (let i = 0; i < 9; i++) window.snake.step() })()"
   },
   {
    "op": "expect_js",
    "expr": "window.snake.state().snake",
    "value": [
     [
      19,
      10
     ],
     [
      18,
      10
     ],
     [
      17,
      10
     ]
    ]
   },
   {
    "op": "expect_js",
    "expr": "window.snake.state().over",
    "value": false
   },
   {
    "op": "js",
    "expr": "(() => { for (let i = 0; i < 1; i++) window.snake.step() })()"
   },
   {
    "op": "expect_js",
    "expr": "window.snake.state().over",
    "value": true
   },
   {
    "op": "js",
    "expr": "(() => { for (let i = 0; i < 1; i++) window.snake.step() })()"
   },
   {
    "op": "expect_js",
