 {
  "name": "food is drawn from the free cells in row-major order",
  "steps": [
   {
    "op": "goto",
    "path": "/?test=1"
   },
   {
    "op": "js",
    "expr": "window.snake.reset(7, {\"snake\": [[19, 0], [18, 0], [17, 0], [16, 0], [15, 0], [14, 0], [13, 0], [12, 0], [11, 0], [10, 0], [9, 0], [8, 0], [7, 0], [6, 0], [5, 0], [4, 0], [3, 0], [2, 0], [1, 0], [0, 0]]})"
   },
   {
    "op": "expect_js",
    "expr": "window.snake.state().food",
    "value": [
     4,
     1
    ]
   },
   {
    "op": "js",
    "expr": "window.snake.reset(99, {\"snake\": [[19, 0], [18, 0], [17, 0], [16, 0], [15, 0], [14, 0], [13, 0], [12, 0], [11, 0], [10, 0], [9, 0], [8, 0], [7, 0], [6, 0], [5, 0], [4, 0], [3, 0], [2, 0], [1, 0], [0, 0]]})"
   },
   {
    "op": "expect_js",
    "expr": "window.snake.state().food",
    "value": [
     18,
     5
    ]
   }
  ]
 },
 {
  "name": "the snake moves one cell per tick",
  "steps": [
   {
    "op": "goto",
    "path": "/?test=1"
   },
   {
    "op": "js",
    "expr": "window.snake.reset(1)"
   },
   {
    "op": "js",
    "expr": "(() => { for (let i = 0; i < 3; i++) window.snake.step() })()"
   },
   {
    "op": "expect_js",
    "expr": "window.snake.state().snake",
    "value": [
     [
      13,
      10
     ],
     [
      12,
      10
     ],
     [
      11,
      10
     ]
    ]
   },
   {
    "op": "expect_js",
    "expr": "window.snake.state().score",
    "value": 0
   }
  ]
 },
