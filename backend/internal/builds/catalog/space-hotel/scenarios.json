 {
  "name": "phone: nothing scrolls sideways, even with the menu, a FAQ answer and the biggest total open",
  "steps": [
   {
    "op": "goto",
    "path": "/"
   },
   {
    "op": "expect_no_hscroll"
   },
   {
    "op": "click",
    "selector": "[data-testid=menu-toggle]"
   },
   {
    "op": "expect_no_hscroll"
   },
   {
    "op": "click",
    "selector": "[data-testid=menu-toggle]"
   },
   {
    "op": "select",
    "selector": "[data-testid=room]",
    "value": "dome"
   },
   {
    "op": "fill",
    "selector": "[data-testid=nights]",
    "value": "30"
   },
   {
    "op": "expect_js",
    "expr": "document.querySelector('[data-testid=total]').textContent.trim()",
    "value": "$158,380"
   },
   {
    "op": "click",
    "selector": "[data-testid=faq-question] >> nth=0"
   },
   {
    "op": "expect_no_hscroll"
   },
   {
    "op": "fill",
    "selector": "[data-testid=email]",
    "value": "a-rather-long-address-for-a-narrow-screen@subdomain.example-company.com"
   },
   {
    "op": "click",
    "selector": "[data-testid=subscribe]"
   },
   {
    "op": "expect_visible",
    "selector": "[data-testid=subscribe-success]"
   },
   {
    "op": "expect_no_hscroll"
   }
  ],
  "viewport": 375
 },
 {
  "name": "the rooms section has three cards with the nightly prices, and the sections exist",
  "steps": [
   {
    "op": "goto",
    "path": "/"
   },
   {
    "op": "expect_js",
    "expr": "!!document.getElementById('rooms')",
    "value": true
   },
   {
    "op": "expect_js",
    "expr": "!!document.getElementById('booking')",
    "value": true
   },
   {
    "op": "expect_js",
    "expr": "!!document.getElementById('faq')",
    "value": true
   },
   {
    "op": "expect_count",
    "selector": "[data-testid=room-card]",
    "count": 3
   },
   {
    "op": "expect_text",
    "selector": "[data-testid=room-card] >> nth=0",
    "text": "$895"
   },
   {
    "op": "expect_text",
    "selector": "[data-testid=room-card] >> nth=1",
    "text": "$1,999"
   },
   {
    "op": "expect_text",
    "selector": "[data-testid=room-card] >> nth=2",
    "text": "$6,495"
   },
   {
    "op": "expect_js",
    "expr": "[...document.querySelectorAll('[data-testid=room] option')].map(o => o.value)",
    "value": [
     "pod",
     "suite",
     "dome"
    ]
   }
  ]
 },
