[
 {
  "name": "desktop: the nav links are visible and there is no burger",
  "steps": [
   {
    "op": "goto",
    "path": "/"
   },
   {
    "op": "expect_visible",
    "selector": "[data-testid=nav-rooms]"
   },
   {
    "op": "expect_visible",
    "selector": "[data-testid=nav-booking]"
   },
   {
    "op": "expect_visible",
    "selector": "[data-testid=nav-faq]"
   },
   {
    "op": "expect_hidden",
    "selector": "[data-testid=menu-toggle]"
   },
   {
    "op": "expect_hidden",
    "selector": "[data-testid=mobile-menu]"
   }
  ]
 },
 {
  "name": "desktop: the nav links scroll to their sections",
  "steps": [
   {
    "op": "goto",
    "path": "/"
   },
   {
    "op": "click",
    "selector": "[data-testid=nav-booking]"
   },
   {
    "op": "expect_js",
    "expr": "location.hash",
    "value": "#booking"
   },
   {
    "op": "expect_js",
    "expr": "(() => { const r = document.getElementById('booking').getBoundingClientRect(); return r.top < innerHeight && r.bottom > 0 })()",
    "value": true
   },
   {
    "op": "click",
    "selector": "[data-testid=nav-faq]"
   },
   {
    "op": "expect_js",
    "expr": "location.hash",
    "value": "#faq"
   },
   {
    "op": "expect_js",
    "expr": "(() => { const r = document.getElementById('faq').getBoundingClientRect(); return r.top < innerHeight && r.bottom > 0 })()",
    "value": true
   },
   {
    "op": "click",
    "selector": "[data-testid=nav-rooms]"
   },
   {
    "op": "expect_js",
    "expr": "location.hash",
    "value": "#rooms"
   },
   {
    "op": "expect_js",
    "expr": "(() => { const r = document.getElementById('rooms').getBoundingClientRect(); return r.top < innerHeight && r.bottom > 0 })()",
    "value": true
   }
  ]
 },
 {
  "name": "phone: the links collapse behind a closed burger",
