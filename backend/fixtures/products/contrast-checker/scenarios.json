   {
    "op": "expect_js",
    "expr": "document.querySelector('[data-testid=aa-large]').getAttribute('data-result')",
    "value": "pass"
   },
   {
    "op": "expect_js",
    "expr": "document.querySelector('[data-testid=aaa-normal]').getAttribute('data-result')",
    "value": "pass"
   },
   {
    "op": "expect_js",
    "expr": "document.querySelector('[data-testid=aaa-large]').getAttribute('data-result')",
    "value": "pass"
   },
