[
 {
  "name": "black on white is 21:1",
  "steps": [
   {
    "op": "goto",
    "path": "/"
   },
   {
    "op": "fill",
    "selector": "[data-testid=fg-input]",
    "value": "#000000"
   },
   {
    "op": "fill",
    "selector": "[data-testid=bg-input]",
    "value": "#ffffff"
   },
