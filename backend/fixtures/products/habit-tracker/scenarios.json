[
 {
  "name": "a new habit starts at zero",
  "timezone": "UTC",
  "steps": [
   {
    "op": "set_time",
    "time": "2026-03-10T12:00:00Z"
   },
   {
    "op": "goto",
    "path": "/"
   },
   {
    "op": "fill",
    "selector": "[data-testid=habit-name-input]",
    "value": "Read"
   },
   {
    "op": "click",
    "selector": "[data-testid=add-habit]"
   },
   {
    "op": "expect_count",
    "selector": "[data-testid=habit]",
    "count": 1
   },
   {
    "op": "expect_js",
    "expr": "document.querySelector('[data-testid=habit-name]').textContent",
    "value": "Read"
   },
   {
    "op": "expect_js",
    "expr": "(h => h ? h.querySelector('[data-testid=streak]').textContent.trim() : null)([...document.querySelectorAll('[data-testid=habit]')].find(h => h.querySelector('[data-testid=habit-name]').textContent === \"Read\"))",
    "value": "0"
   },
   {
    "op": "expect_js",
    "expr": "(h => h ? h.querySelector('[data-testid=best-streak]').textContent.trim() : null)([...document.querySelectorAll('[data-testid=habit]')].find(h => h.querySelector('[data-testid=habit-name]').textContent === \"Read\"))",
    "value": "0"
   },
   {
    "op": "expect_js",
    "expr": "(h => h ? h.querySelector('[data-testid=rate]').textContent.trim() : null)([...document.querySelectorAll('[data-testid=habit]')].find(h => h.querySelector('[data-testid=habit-name]').textContent === \"Read\"))",
    "value": "0%"
   },
   {
    "op": "expect_js",
    "expr": "(h => { const b = h && h.querySelector('[data-testid=day-2026-03-10]'); return b ? b.getAttribute('aria-pressed') : null; })([...document.querySelectorAll('[data-testid=habit]')].find(h => h.querySelector('[data-testid=habit-name]').textContent === \"Read\"))",
    "value": "false"
   }
  ]
 },
 {
