[
 {
  "name": "offers the five categories",
  "steps": [
   {
    "op": "goto",
    "path": "/"
   },
   {
    "op": "expect_count",
    "selector": "[data-testid=category] option",
    "count": 5
   }
  ]
 },
 {
  "name": "converts length m to ft",
  "steps": [
   {
    "op": "goto",
    "path": "/"
   },
   {
    "op": "select",
    "selector": "[data-testid=category]",
    "value": "length"
   },
   {
    "op": "select",
    "selector": "[data-testid=from-unit]",
    "value": "m"
   },
   {
    "op": "select",
    "selector": "[data-testid=to-unit]",
    "value": "ft"
   },
   {
    "op": "fill",
    "selector": "[data-testid=from-value]",
    "value": "100"
   },
   {
    "op": "expect_number",
    "selector": "[data-testid=to-value]",
    "value": 328.084,
    "tolerance": 0.01
   }
  ]
 },
