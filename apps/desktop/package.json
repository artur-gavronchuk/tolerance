{
  "name": "@studio/desktop",
  "productName": "Studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Studio: plan a change, let agents build it, verify against the plan",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:e2e": "electron-vite build && playwright test",
    "rebuild-native": "electron-rebuild -f -o better-sqlite3",
    "postinstall": "node scripts/node-pty-permissions.mjs"
  },
  "dependencies": {
    "@studio/agents": "workspace:*",
    "@studio/db": "workspace:*",
    "@studio/engine": "workspace:*",
    "@studio/git": "workspace:*",
    "@studio/schema": "workspace:*",
    "@tanstack/react-query": "^5.105.0",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@trpc/tanstack-react-query": "^11.19.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "i18next": "^26.5.11",
    "node-pty": "1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
}
