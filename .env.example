# Copy to .env (make up does it for you). Never commit .env.
POSTGRES_PASSWORD=arena_migrate_dev_password
ARENA_APP_ROLE_PASSWORD=arena_app_dev_password
ARENA_ADMIN_EMAILS=admin@arena.local
# Host ports (change if something else already listens there; Superset
# workspaces pick free ports for these automatically, see .superset/setup.sh).
WEB_PORT=3000
API_PORT=8080
DEX_PORT=5556

# Local defaults; on a server set the public origins instead, e.g.
# ARENA_WEB_ORIGIN=https://arena.example.com
# ARENA_OIDC_ISSUER=https://auth.example.com/dex
# ARENA_OIDC_JWKS_URL=http://dex:5556/dex/keys
