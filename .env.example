# Copy to .env (make up does it). Never commit .env.
ARENA_ENV=development
POSTGRES_PASSWORD=arena_migrate_dev_password
ARENA_APP_ROLE_PASSWORD=arena_app_dev_password
ARENA_ADMIN_EMAILS=

# Host ports (change if something else already listens there; Superset
# workspaces pick free ports for these automatically, see .superset/setup.sh).
WEB_PORT=3000
API_PORT=8080

# Group owning docker.sock inside containers; `make up` detects it. Set it
# here only if detection is wrong for your host.
# DOCKER_GID=

# Server only (docker compose --profile prod):
# ARENA_ENV=production
# ARENA_DOMAIN=arena.example.com
# ARENA_SECURE_COOKIES=true
