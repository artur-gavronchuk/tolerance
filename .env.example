# Copy to .env (make up does it). Never commit .env.
ARENA_ENV=development
POSTGRES_PASSWORD=arena_migrate_dev_password
ARENA_APP_ROLE_PASSWORD=arena_app_dev_password
ARENA_ADMIN_EMAILS=

# Sign in as any email without GitHub/Google. Local runs and CI only; the
# api refuses to start with it next to ARENA_SECURE_COOKIES=true.
ARENA_DEV_LOGIN=true

# Sign-in providers. Leave empty to have only the dev login locally. Register
# a GitHub OAuth App (github.com/settings/developers) and a Google OAuth client
# (console.cloud.google.com → APIs & Services → Credentials, Web application)
# with the callback {ARENA_PUBLIC_URL}/api/v1/auth/{github,google}/callback.
ARENA_PUBLIC_URL=http://localhost:3000
ARENA_GITHUB_CLIENT_ID=
ARENA_GITHUB_CLIENT_SECRET=
ARENA_GOOGLE_CLIENT_ID=
ARENA_GOOGLE_CLIENT_SECRET=

# Host ports (change if something else already listens there; Superset
# workspaces pick free ports for these automatically, see .superset/setup.sh).
WEB_PORT=3000
API_PORT=8080

# Group owning docker.sock inside containers; `make up` detects it. Set it
# here only if detection is wrong for your host.
# DOCKER_GID=

# Server only (docker compose --profile prod). deploy/deploy.sh writes all of
# this for you on first deploy, sized from the host's nproc/RAM; edit .env
# on the server afterwards and re-run `make up` (or deploy/scale.sh) to
# change it.
# ARENA_ENV=production
# ARENA_DOMAIN=tolerance.cc
# ARENA_SECURE_COOKIES=true
# ARENA_DEV_LOGIN=false
# ARENA_PUBLIC_URL=https://arena.example.com
# Where /terms tells people to write to delete their data (baked into the
# web build; rebuild the web image after changing it).
# ARENA_CONTACT_EMAIL=hello@tolerance.cc

# --- Capacity: connections, workers, Postgres ------------------------------
# Postgres connection pool size for the api/worker roles (pgx pool_max_conns
# query param). Keep ARENA_DB_POOL_MAX * (api + worker replicas) comfortably
# under PG_MAX_CONNECTIONS.
# ARENA_DB_POOL_MAX=20
# Parallel sandbox runs per worker process; each run can use up to ~1
# vCPU/1 GB, so size against the worker host's spare capacity.
# ARENA_WORKER_CONCURRENCY=1
# Tanks bot matches (worker role): the runtime image (built by `make up`'s
# bot-image target from backend/internal/games/match/runtime), how often
# the games worker schedules a tick, and how many matches it runs
# concurrently. Empty ARENA_BOT_IMAGE defaults to arena-bot-runtime:1.
# ARENA_BOT_IMAGE=arena-bot-runtime:1
# ARENA_MATCH_INTERVAL=20s
# ARENA_MATCH_CONCURRENCY=1
# Postgres tuning (see docker-compose.yml `postgres.command`); deploy.sh
# sizes shared_buffers/effective_cache_size from RAM (25%/60%).
# PG_MAX_CONNECTIONS=200
# PG_SHARED_BUFFERS=128MB
# PG_EFFECTIVE_CACHE_SIZE=512MB
# PG_WORK_MEM=4MB
# PG_MAINTENANCE_WORK_MEM=64MB
# PG_SHM_SIZE=256mb
# Bind address for Postgres' published port. 127.0.0.1 unless you're running
# remote sandbox workers (deploy/add-worker.sh) — then set it to this host's
# private network IP, and set PG_ALLOW_CIDR (below) to match.
# PG_BIND=127.0.0.1

# --- Scaling: replica counts (deploy/compose.prod.yml, ARENA_ENV=production)
# Changed live by `deploy/scale.sh`/`make scale`, no rebuild needed.
# API_REPLICAS=1
# WEB_REPLICAS=1
# WORKER_REPLICAS=1

# --- Monitoring (docker compose --profile monitoring, ARENA_MONITORING=true)
# ARENA_MONITORING=true
# Required whenever monitoring is on in production; `make up` refuses to
# start otherwise. Grafana is served at https://$ARENA_DOMAIN/grafana.
# GRAFANA_ADMIN_PASSWORD=
# Prometheus retention.
# PROM_RETENTION=30d
# Optional: Grafana alert notifications go to Telegram instead of the
# default email contact point when both are set (rendered into Grafana's
# alerting provisioning by deploy/deploy.sh — see
# deploy/render-telegram-alerting.sh).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Centralized logging (Loki + Alloy, part of the monitoring profile).
# Bind address for Loki's published port — 127.0.0.1 unless remote workers
# ship logs here too (deploy/add-worker.sh), same posture as PG_BIND.
# LOKI_BIND=127.0.0.1
# Memory caps so a log burst can't starve api/worker/postgres on a small box.
# LOKI_MEM_LIMIT=512m
# ALLOY_MEM_LIMIT=256m

# --- Abuse protection -------------------------------------------------------
# Per-IP and per-API-key rate limits enforced by the api service.
# ARENA_RATE_IP_RPS=20
# ARENA_RATE_IP_BURST=60
# ARENA_RATE_KEY_RPS=5
# ARENA_RATE_KEY_BURST=20
# CIDR allowed to reach Postgres' published port when PG_BIND is a private
# IP (deploy/cf-origin-lock.sh's Postgres sibling rule); e.g. the Hetzner
# Cloud Network range for this project.
# PG_ALLOW_CIDR=

# --- deploy.sh: local-only, never written to the server's .env ------------
# If both are set in the shell running deploy.sh (not in any .env file),
# it purges the Cloudflare cache for the connector download URLs after a
# successful deploy so new connector binaries go out immediately.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
