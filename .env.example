# Copy to .env (make up / make dev do it). Never commit .env.
POSTGRES_PASSWORD=arena_migrate_dev_password
ARENA_APP_ROLE_PASSWORD=arena_app_dev_password
ARENA_ADMIN_EMAILS=
# Sign in as any email without GitHub/Google.
ARENA_DEV_LOGIN=true
# Quotas (3 attempts a day at the daily task, bot uploads) off.
ARENA_NO_LIMITS=true

# Optional OAuth; callback {ARENA_PUBLIC_URL}/api/v1/auth/{github,google}/callback.
ARENA_PUBLIC_URL=http://localhost:3000
ARENA_GITHUB_CLIENT_ID=
ARENA_GITHUB_CLIENT_SECRET=
ARENA_GOOGLE_CLIENT_ID=
ARENA_GOOGLE_CLIENT_SECRET=

# Host ports (Superset workspaces pick free ones, see .superset/setup.sh).
WEB_PORT=3000
API_PORT=8080
PG_PORT=5432

# fake: no Docker for submission runs (every hidden test "passes"), tanks bots run
# as local processes. docker: the real sandbox.
# ARENA_SANDBOX=docker
# Tanks ladder tick.
# ARENA_MATCH_INTERVAL=20s
# Task catalog (<language>/<task>/) mounted into migrate; the private daily tasks live in
# artur-gavronchuk/arena-tasks.
# ARENA_SKILLS_SOURCE=../arena-tasks/skills
